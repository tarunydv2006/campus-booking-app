PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_DB_NAME=smart-campus-booking
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional email settings. If omitted, emails are logged to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
MAIL_FROM="Smart Campus Booking <no-reply@campus.local>"

ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=replace_with_secure_admin_password
